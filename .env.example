# Leave blank to use the clearly marked local demo adapter.
# Public API URL only. Never put Railway credentials or wallet keys here.
VITE_API_BASE_URL=
# Optional; relative paths work on GitHub Pages project URLs by default.
VITE_BASE_PATH=./

# Live Pump.fun links follow the main token saved in Admin > Main token.
# Optional demo-only mint override; ignored in live mode. Sample addresses are never linked.
VITE_MAIN_TOKEN_MINT=
# Official public X profile URL. Blank links to x.com as a placeholder.
VITE_KANTO_X_URL=
# Public operator/contact information for the draft legal pages.
VITE_LEGAL_OPERATOR=
VITE_LEGAL_CONTACT_EMAIL=
