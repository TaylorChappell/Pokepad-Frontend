{
  "name": "kanto-frontend",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -b",
    "preview:file": "npm run build && node scripts/create-preview.mjs",
    "format": "prettier --write src tests scripts *.json *.ts *.html docs README.md .github"
  },
  "dependencies": {
    "@metamask/connect-solana": "^2.1.1",
    "@solana/wallet-standard-features": "^1.5.0",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "bs58": "^6.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "overrides": {
    "@metamask/utils": {
      "uuid": "11.1.1"
    }
  }
}
